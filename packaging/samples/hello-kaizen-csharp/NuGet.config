<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- The Kaizen .NET SDK is distributed with the engine, not NuGet.org.
         This path is relative to this file and resolves inside a packaged
         distribution (Samples/hello-kaizen-csharp/ -> Engine/Managed/...). -->
    <add key="kaizen-local" value="../../Engine/Managed/KaizenSharp/Tools/nupkgs" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
