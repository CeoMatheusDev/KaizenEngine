#include "core/version.h"

#ifndef RT_MANIFEST
#define RT_MANIFEST 24
#endif

KAIZEN_ICON ICON platform/windows/kaizen_console.ico
1 RT_MANIFEST "platform/windows/kaizen.manifest"

1 VERSIONINFO
FILEVERSION     KAIZEN_VERSION_MAJOR,KAIZEN_VERSION_MINOR,KAIZEN_VERSION_PATCH,0
PRODUCTVERSION  KAIZEN_VERSION_MAJOR,KAIZEN_VERSION_MINOR,KAIZEN_VERSION_PATCH,0
FILEOS          4
FILETYPE        1
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription",        KAIZEN_VERSION_NAME " (Console)"
            VALUE "FileVersion",            KAIZEN_VERSION_NUMBER
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
