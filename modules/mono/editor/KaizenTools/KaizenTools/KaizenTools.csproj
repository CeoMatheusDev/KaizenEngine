<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ProjectGuid>{27B00618-A6F2-4828-B922-05CAEB08C286}</ProjectGuid>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>enable</Nullable>
    <!-- The Kaizen editor uses the Debug Kaizen API assemblies -->
    <KaizenApiConfiguration>Debug</KaizenApiConfiguration>
    <KaizenSourceRootPath>$(SolutionDir)/../../../../</KaizenSourceRootPath>
    <KaizenOutputDataDir>$(KaizenSourceRootPath)/bin/KaizenSharp</KaizenOutputDataDir>
    <KaizenApiAssembliesDir>$(KaizenOutputDataDir)/Api/$(KaizenApiConfiguration)</KaizenApiAssembliesDir>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- Needed for our source generators to work despite this not being a Kaizen game project -->
  <PropertyGroup>
    <IsKaizenToolsProject>true</IsKaizenToolsProject>
  </PropertyGroup>

  <ItemGroup>
    <CompilerVisibleProperty Include="IsKaizenToolsProject" />
  </ItemGroup>

  <PropertyGroup Condition=" Exists('$(KaizenApiAssembliesDir)/KaizenSharp.dll') ">
    <!-- The project is part of the Kaizen source tree -->
    <!-- Use the Kaizen source tree output folder instead of '$(ProjectDir)/bin' -->
    <OutputPath>$(KaizenOutputDataDir)/Tools</OutputPath>
    <!-- Must not append '$(TargetFramework)' to the output path in this case -->
    <AppendTargetFrameworkToOutputPath>False</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="JetBrains.Annotations" Version="2019.1.3.0" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.11.0" />
    <PackageReference Include="JetBrains.Rider.PathLocator" Version="1.0.12" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.0" PrivateAssets="All" />
    <PackageReference Include="Microsoft.VisualStudio.SolutionPersistence" Version="1.0.52" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.1" />
    <Reference Include="KaizenSharp">
      <HintPath>$(KaizenApiAssembliesDir)/KaizenSharp.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="KaizenSharpEditor">
      <HintPath>$(KaizenApiAssembliesDir)/KaizenSharpEditor.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Kaizen.NET.Sdk\Kaizen.SourceGenerators\Kaizen.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\..\glue\KaizenSharp\Kaizen.SourceGenerators.Internal\Kaizen.SourceGenerators.Internal.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KaizenTools.BuildLogger\KaizenTools.BuildLogger.csproj" />
    <ProjectReference Include="..\KaizenTools.IdeMessaging\KaizenTools.IdeMessaging.csproj" />
    <ProjectReference Include="..\KaizenTools.ProjectEditor\KaizenTools.ProjectEditor.csproj" />
    <ProjectReference Include="..\KaizenTools.Core\KaizenTools.Core.csproj" />
  </ItemGroup>

</Project>
