<Project>
  <Import Project="$(MSBuildThisFileDirectory)\SdkPackageVersions.props" />

  <PropertyGroup>
    <UsingKaizenNETSdk>true</UsingKaizenNETSdk>

    <!-- Determines if we should import Microsoft.NET.Sdk, if it wasn't already imported. -->
    <KaizenSdkImportsMicrosoftNetSdk Condition=" '$(UsingMicrosoftNETSdk)' != 'true' ">true</KaizenSdkImportsMicrosoftNetSdk>
  </PropertyGroup>

  <PropertyGroup>
    <Configurations>Debug;ExportDebug;ExportRelease</Configurations>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>

    <KaizenProjectDir Condition=" '$(KaizenProjectDir)' == '' ">$(MSBuildProjectDirectory)</KaizenProjectDir>
    <KaizenProjectDir>$([MSBuild]::EnsureTrailingSlash('$(KaizenProjectDir)'))</KaizenProjectDir>
    <KaizenProjectDirBase64 Condition=" $([MSBuild]::VersionGreaterThanOrEquals($(MSBuildAssemblyVersion), '17.3')) ">$([MSBuild]::ConvertToBase64('$(KaizenProjectDir)'))</KaizenProjectDirBase64>

    <!-- Custom output paths for Kaizen projects. In brief, 'bin\' and 'obj\' are moved to '$(KaizenProjectDir)\.kaizen\mono\temp\'. -->
    <BaseOutputPath>$(KaizenProjectDir).kaizen\mono\temp\bin\</BaseOutputPath>
    <OutputPath>$(KaizenProjectDir).kaizen\mono\temp\bin\$(Configuration)\</OutputPath>
    <!--
    Use custom IntermediateOutputPath and BaseIntermediateOutputPath only if it wasn't already set.
    Otherwise the old values may have already been changed by MSBuild which can cause problems with NuGet.
    -->
    <IntermediateOutputPath Condition=" '$(IntermediateOutputPath)' == '' ">$(KaizenProjectDir).kaizen\mono\temp\obj\$(Configuration)\</IntermediateOutputPath>
    <BaseIntermediateOutputPath Condition=" '$(BaseIntermediateOutputPath)' == '' ">$(KaizenProjectDir).kaizen\mono\temp\obj\</BaseIntermediateOutputPath>

    <!-- Do not append the target framework name to the output path. -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <Target Condition=" $([MSBuild]::VersionLessThan($(MSBuildAssemblyVersion), '17.3')) " Name="KaizenProjectDir" BeforeTargets="Build">
    <Error Text="Cannot build from path containing '%23', move your project or update dotnet to the latest version." Condition="$(KaizenProjectDir.Contains('%23'))" /> <!-- # -->
    <Error Text="Cannot build from path containing '%3B', move your project or update dotnet to the latest version." Condition="$(KaizenProjectDir.Contains('%3B'))" /> <!-- ; -->
    <Error Text="Cannot build from path containing newlines, move your project or update dotnet to the latest version." Condition="$(KaizenProjectDir.Contains('%0A'))" /> <!-- \n -->
    <Error Text="Cannot build from path containing newlines, move your project or update dotnet to the latest version." Condition="$(KaizenProjectDir.Contains('%0D'))" /> <!-- \r -->
  </Target>

  <Import Sdk="Microsoft.NET.Sdk" Project="Sdk.props" Condition=" '$(KaizenSdkImportsMicrosoftNetSdk)' == 'true' " />

  <PropertyGroup>
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
  </PropertyGroup>

  <!--
  The Microsoft.NET.Sdk only understands of the Debug and Release configurations.
  We need to set the following properties manually for ExportDebug and ExportRelease.
  -->
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' or '$(Configuration)' == 'ExportDebug' ">
    <DebugSymbols Condition=" '$(DebugSymbols)' == '' ">true</DebugSymbols>
    <Optimize Condition=" '$(Optimize)' == '' ">false</Optimize>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'ExportRelease' ">
    <Optimize Condition=" '$(Optimize)' == '' ">true</Optimize>
  </PropertyGroup>

  <PropertyGroup>
    <KaizenApiConfiguration Condition=" '$(Configuration)' != 'ExportRelease' ">Debug</KaizenApiConfiguration>
    <KaizenApiConfiguration Condition=" '$(Configuration)' == 'ExportRelease' ">Release</KaizenApiConfiguration>
  </PropertyGroup>

  <!-- Auto-detect the target Kaizen platform if it was not specified. -->
  <PropertyGroup Condition=" '$(KaizenTargetPlatform)' == '' ">
    <KaizenTargetPlatform Condition=" $(RuntimeIdentifier.StartsWith('ios')) ">ios</KaizenTargetPlatform>
    <KaizenTargetPlatform Condition=" '$(KaizenTargetPlatform)' == '' and $(RuntimeIdentifier.StartsWith('android')) ">android</KaizenTargetPlatform>
    <KaizenTargetPlatform Condition=" '$(KaizenTargetPlatform)' == '' and $(RuntimeIdentifier.StartsWith('browser')) ">web</KaizenTargetPlatform>

    <KaizenTargetPlatform Condition=" '$(KaizenTargetPlatform)' == '' and $(RuntimeIdentifier.StartsWith('linux')) ">linuxbsd</KaizenTargetPlatform>
    <KaizenTargetPlatform Condition=" '$(KaizenTargetPlatform)' == '' and $(RuntimeIdentifier.StartsWith('freebsd')) ">linuxbsd</KaizenTargetPlatform>
    <KaizenTargetPlatform Condition=" '$(KaizenTargetPlatform)' == '' and $(RuntimeIdentifier.StartsWith('osx')) ">macos</KaizenTargetPlatform>
    <KaizenTargetPlatform Condition=" '$(KaizenTargetPlatform)' == '' and $(RuntimeIdentifier.StartsWith('win')) ">windows</KaizenTargetPlatform>
  </PropertyGroup>

  <!-- Auto-detect the target Kaizen platform if it was not specified and there's no runtime identifier information. -->
  <PropertyGroup Condition=" '$(KaizenTargetPlatform)' == '' ">
    <KaizenTargetPlatform Condition=" '$([MSBuild]::IsOsPlatform(Linux))' ">linuxbsd</KaizenTargetPlatform>
    <KaizenTargetPlatform Condition=" '$([MSBuild]::IsOsPlatform(FreeBSD))' ">linuxbsd</KaizenTargetPlatform>
    <KaizenTargetPlatform Condition=" '$([MSBuild]::IsOsPlatform(OSX))' ">macos</KaizenTargetPlatform>
    <KaizenTargetPlatform Condition=" '$([MSBuild]::IsOsPlatform(Windows))' ">windows</KaizenTargetPlatform>
  </PropertyGroup>

  <PropertyGroup>
    <KaizenFloat64 Condition=" '$(KaizenFloat64)' == '' ">false</KaizenFloat64>
  </PropertyGroup>

  <!-- Kaizen DefineConstants. -->
  <PropertyGroup>
    <!-- Define constants to identify Kaizen builds. -->
    <_KaizenDefineConstants>KAIZEN</_KaizenDefineConstants>

    <!--
    Define constant to determine the target Kaizen platform. This includes the
    recognized platform names and the platform category (PC, MOBILE or WEB).
    -->
    <_KaizenPlatformConstants Condition=" '$(KaizenTargetPlatform)' == 'windows' ">KAIZEN_WINDOWS;KAIZEN_PC</_KaizenPlatformConstants>
    <_KaizenPlatformConstants Condition=" '$(KaizenTargetPlatform)' == 'linuxbsd' ">KAIZEN_LINUXBSD;KAIZEN_PC</_KaizenPlatformConstants>
    <_KaizenPlatformConstants Condition=" '$(KaizenTargetPlatform)' == 'macos' ">KAIZEN_OSX;KAIZEN_MACOS;KAIZEN_PC</_KaizenPlatformConstants>
    <_KaizenPlatformConstants Condition=" '$(KaizenTargetPlatform)' == 'android' ">KAIZEN_ANDROID;KAIZEN_MOBILE</_KaizenPlatformConstants>
    <_KaizenPlatformConstants Condition=" '$(KaizenTargetPlatform)' == 'ios' ">KAIZEN_IPHONE;KAIZEN_IOS;KAIZEN_MOBILE</_KaizenPlatformConstants>
    <_KaizenPlatformConstants Condition=" '$(KaizenTargetPlatform)' == 'web' ">KAIZEN_JAVASCRIPT;KAIZEN_HTML5;KAIZEN_WASM;KAIZEN_WEB</_KaizenPlatformConstants>

    <_KaizenDefineConstants>$(_KaizenDefineConstants);$(_KaizenPlatformConstants);$(_KaizenVersionConstants)</_KaizenDefineConstants>
  </PropertyGroup>

  <Import Project="$(MSBuildThisFileDirectory)\Android.props" Condition=" '$(KaizenTargetPlatform)' == 'android' " />
  <Import Project="$(MSBuildThisFileDirectory)\iOS.props" Condition=" '$(KaizenTargetPlatform)' == 'ios' " />
</Project>
