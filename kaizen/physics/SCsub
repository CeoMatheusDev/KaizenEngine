#!/usr/bin/env python
from misc.utility.scons_hints import *

Import("env")

if not env["disable_physics_3d"]:
    SConscript("backend/SCsub")
    SConscript("collision/SCsub")
    SConscript("simulation/SCsub")
    SConscript("diagnostics/SCsub")

    # NVIDIA PhysX physics backend (only when explicitly enabled). Included
    # here only - kaizen/SCsub must not include physx/SCsub again, or the
    # sources would be compiled twice.
    if env["builtin_physx"]:
        SConscript("physx/SCsub")
