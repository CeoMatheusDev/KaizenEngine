#!/usr/bin/env python
from misc.utility.scons_hints import *

Import("env")

if not env["disable_physics_3d"]:
    SConscript("backend/SCsub")
    SConscript("collision/SCsub")
    SConscript("simulation/SCsub")
    SConscript("diagnostics/SCsub")

    # The NVIDIA PhysX backend (kaizen/physics/physx/*.cpp) is compiled by
    # modules/physx_physics_3d/SCsub together with the SDK sources and the
    # module TUs. Keeping every PhysX symbol in one archive resolves the
    # kaizen-lib <-> module-lib circular reference the single-pass linker
    # cannot settle.
