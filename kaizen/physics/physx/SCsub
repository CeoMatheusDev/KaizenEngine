#!/usr/bin/env python
from misc.utility.scons_hints import *

import os

Import("env")

# SDK presence detection (and the PHYSX_ENABLED defines) happens in
# SConstruct before module detection. By this point env["builtin_physx"] is
# only True when the PhysX SDK sources are actually installed.
#
# The PhysX SDK sources themselves are compiled directly into the engine by
# modules/physx_physics_3d/SCsub (no CMake step, no prebuilt libraries to
# track down). This backend only adds the Kaizen glue (settings, overrides,
# PVD wiring) plus the SDK headers it needs to compile against.

if not env["builtin_physx"]:
    Return()

# Note: "#" anchors the path at the project root; Dir() in an SConscript
# would otherwise resolve relative paths against this script's directory.
physx_sdk_path = env["physx_sdk_path"]
physx_dir = str(Dir("#" + physx_sdk_path).abspath) if not os.path.isabs(physx_sdk_path) else physx_sdk_path

# The cloned repo can place the PhysX SDK under physx/physx/, physx/ or
# directly at the configured path depending on how it was obtained.
if os.path.exists(physx_dir + "/physx/physx/include/foundation/PxFoundation.h"):
    physx_source_dir = physx_dir + "/physx/physx/"
elif os.path.exists(physx_dir + "/physx/include/foundation/PxFoundation.h"):
    physx_source_dir = physx_dir + "/physx/"
elif os.path.exists(physx_dir + "/include/foundation/PxFoundation.h"):
    physx_source_dir = physx_dir + "/"
else:
    physx_source_dir = physx_dir + "/physx/physx/"

if not os.path.exists(physx_source_dir + "include/foundation/PxFoundation.h"):
    print("NVIDIA PhysX SDK source not found in " + physx_source_dir)
    print("Please run: python3 tools/sdk/sdk_manager.py --download physx/physx")
    env["builtin_physx"] = False
    env["builtin_physx_extensions"] = False
    env["builtin_physx_gpu"] = False
    Return()

# Headers only - the SDK objects come from the module's in-tree build.
env.EitherAppend("CPPPATH", [
    physx_source_dir + "include",
    physx_source_dir + "pvdruntime/include",
])

print("NVIDIA PhysX SDK detected - PhysX backend enabled")

# Source files
module_obj = []
env.add_source_files(module_obj, "*.cpp")
env.kaizen_sources += module_obj
