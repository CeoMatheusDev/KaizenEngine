; Engine configuration file.
; Diagnostics churn project: creates and frees GPU textures every frame to
; exercise the deferred resource release path.

config_version=5

[application]

config/name="Kaizen Resource Churn Test"
config/description="Per-frame GPU texture churn used to validate Kaizen resource lifetime diagnostics."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.8", "Forward Plus")

[display]

window/size/viewport_width=320
window/size/viewport_height=240
window/vsync/vsync_mode=0

[rendering]

textures/default_filters/anisotropic_filtering_level=0
