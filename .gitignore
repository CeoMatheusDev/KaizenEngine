# Kaizen Engine .gitignore (based on upstream Godot's)
/build/

/custom.py

# Generated files
bin
*.gen.*
compile_commands.json
platform/windows/godot_res.res
*.ninja
.ninja/
run_ninja_env.bat
.import/
/gdextension_interface.h
/gdextension_interface.json
extension_api.json
logs/
# A boot trace left at the repository root by hand. Run evidence belongs under
# benchmarks/results/<run>/, where the .log files there are tracked on purpose - so this
# is anchored to the root path instead of a global *.log, which would fight that.
/pipeline_run.log
tests/data/*.translation
tests/data/crypto/out*

