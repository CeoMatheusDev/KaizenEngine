; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Kaizen Benchmarks (2D)"
config/description="Deterministic 2D/Canvas benchmark scenes for the Kaizen rendering baseline."
run/main_scene="res://scenes/bootstrap.tscn"
config/features=PackedStringArray("4.8", "Forward Plus")

[autoload]

BenchHarness="*res://scripts/bench_harness.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/vsync/vsync_mode=0

[rendering]

textures/default_filters/anisotropic_filtering_level=0
