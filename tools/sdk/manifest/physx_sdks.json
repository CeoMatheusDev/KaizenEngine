          "include/common/",
          "include/core/",
          "include/physx/"
        ]
      },
      "build_from_source": true,
      "cmake_build": true,
      "cmake_options": [
        "-DPX_BUILD_DEFAULT_SAMPLES=OFF",
        "-DPX_BUILD_TOOLS=OFF",
        "-DPX_BUILD_TESTSUITE=OFF",
        "-DPX_BUILD_COOKING=ON",
        "-DPX_BUILD_EXTENSIONS=ON",
        "-DPX_BUILD_CHARACTER_KINEMATIC=ON",
        "-DPX_BUILD_VEHICLE=ON",
        "-DPX_BUILD_GPU=OFF",
        "-DCMAKE_BUILD_TYPE=Release"
      ],
      "required_libraries": [
        "PhysXFoundation",
        "PhysXCommon",
        "PhysXCore",
        "PhysXCooking",
        "PhysXExtensions",
        "PhysXCharacterKinematic",
        "PhysXVehicle"
      ],
      "build_flag": "PHYSX_ENABLED",
      "notes": "PhysX 5 is Apache 2.0, fully open source. Can be cloned and built from source. No developer account required."
    },
